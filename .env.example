# Content generation only. The browser never reads the PDF path.
DEMO_PDF_PATH=C:\path\to\approved-textbook.pdf

# MinerU local CLI settings used by scripts/ingest-pdf.mjs.
MINERU_PYTHON=.venv-mineru\Scripts\python.exe
MINERU_METHOD=ocr
MINERU_LANGUAGE=ch

# Optional deterministic UI delay for the demo repository.
VITE_DEMO_DELAY_MS=80

# Optional personal BYOK for short-lived local DeepSeek demo builds only.
# Never commit a real value; put it in the gitignored .env.local instead.
VITE_DEEPSEEK_API_KEY=
